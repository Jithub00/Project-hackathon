# Copy to .env (never commit .env). Every value is optional for the demonstration build.

# Server
PORT=4000
# SQLite database file (created on first start). Use RESET_DB=1 to wipe and re-seed.
DB_PATH=data/photoshoot.db
RESET_DB=0
# Demonstration sample data is seeded on an empty database. Set to 0 to skip it.
SEED_DEMO=1
# Uploads (photos and videos) are stored here.
UPLOADS_DIR=uploads
# Folder with the built client (npm run build).
DIST_DIR=dist
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Payments: "demo" (default) simulates payments. "stripe" uses live Stripe keys.
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Private messaging (see docs/MESSAGING.md). Limits apply per account, per server process.
MESSAGE_SEND_LIMIT_PER_MINUTE=30
CONVERSATION_START_LIMIT_PER_HOUR=10
MESSAGE_STREAMS_PER_USER=5
REPORTS_PER_HOUR=10
# Comma-separated reviewer addresses. Self-service sign-up cannot use them, so an address cannot be claimed before its owner.
MODERATOR_EMAILS=
# Reviewer account created or confirmed at start-up. Reviewer access is granted only when the password matches.
# Reviewers decide message reports and refund requests. See docs/MESSAGING.md and docs/PAYMENTS.md.
STAFF_BOOTSTRAP_EMAIL=
STAFF_BOOTSTRAP_PASSWORD=
# Comma-separated extra origins allowed to use messaging, for example https://photoshoot.example.
ALLOWED_ORIGINS=
